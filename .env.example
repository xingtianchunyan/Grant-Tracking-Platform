# --- 基础配置 (必需) ---
# 数据库连接地址。本地开发可使用 Docker 部署的 Postgres，生产环境推荐使用 Neon.
# 示例: postgresql://postgres:postgres@localhost:5432/grant_tracking?sslmode=disable
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?sslmode=disable"

# 内部服务通信 Token。用于保护内部 API (如 Discord 机器人调用的接口)。
# 本地开发可填入任意随机字符串。
SERVICE_BOT_TOKEN="your-super-secret-service-token"

# 后端基础 URL，用于 Discord 机器人回调和 API 访问。
BACKEND_URL="http://localhost:3001"

# --- GitHub 集成 (必需，用于代码活动追踪) ---
# GitHub 个人访问令牌 (Personal Access Token)，需具备 repo 权限。
GITHUB_TOKEN="ghp_your_github_token_here"

# --- Discord 机器人配置 (必需) ---
# Discord 机器人的 Token (从 Discord Developer Portal 获取)。
DISCORD_BOT_TOKEN_COMMANDER="your_discord_bot_token"

# Discord 机器人的应用 ID (Application ID)。
DISCORD_APP_ID_COMMANDER="your_discord_app_id"

# 机器人所在的服务器 ID (Guild ID)。
DISCORD_GUILD_ID="your_discord_guild_id"

# (可选) Discord 公钥，用于 Webhook 模式验证。WebSocket 模式下可为空。
DISCORD_PUBLIC_KEY=""

# --- AI 与增强功能 (可选) ---
# SiliconFlow API Key。用于 AI 自动提取项目信息功能。
# 若不填，系统将自动回退到模拟提取模式 (Mock Mode)。
SILICONFLOW_API_KEY="sk-your-siliconflow-api-key"

# (可选) 代理配置。若在中国大陆环境下开发，可能需要配置全局代理以访问 GitHub/Discord API。
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"
